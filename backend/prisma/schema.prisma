
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.NVarChar(36)
  firstName    String    @db.NVarChar(100)
  lastName     String    @db.NVarChar(100)
  email        String    @unique @db.NVarChar(255)
  passwordHash String    @db.NVarChar(255)
  role         String    @default("USER") @db.NVarChar(12)
  createdAt    DateTime  @default(now())

  orders       Order[]
  reviews      Review[]
  favorites    Favorite[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid()) @db.NVarChar(36)
  tokenHash String   @unique @db.NVarChar(64)
  userId    String   @db.NVarChar(36)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String   @id @default(uuid()) @db.NVarChar(36)
  name        String   @db.NVarChar(250)
  brand       String   @db.NVarChar(150)
  category    String   @db.NVarChar(100)
  description String   @default("") @db.NVarChar(Max)
  image       String   @default("") @db.NVarChar(1000)
  price       Int
  stock       Int      @default(0)
  sizes       String   @default("ONE SIZE") @db.NVarChar(300)
  featured    Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]
}

model Order {
  id            String   @id @default(uuid()) @db.NVarChar(36)
  number        String   @unique @db.NVarChar(40)
  userId        String   @db.NVarChar(36)
  recipient     String   @db.NVarChar(200)
  email         String   @db.NVarChar(255)
  phone         String   @db.NVarChar(40)
  city          String   @db.NVarChar(100)
  address       String   @db.NVarChar(500)
  comment       String   @default("") @db.NVarChar(1000)
  status        String   @default("NEW") @db.NVarChar(30)
  paymentStatus String   @default("UNPAID") @db.NVarChar(20)
  subtotal      Int
  delivery      Int
  total         Int
  createdAt     DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid()) @db.NVarChar(36)
  orderId   String @db.NVarChar(36)
  productId String @db.NVarChar(36)
  name      String @db.NVarChar(250)
  size      String @db.NVarChar(50)
  price     Int
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(uuid()) @db.NVarChar(36)
  productId String   @db.NVarChar(36)
  userId    String   @db.NVarChar(36)
  rating    Int
  text      String   @db.NVarChar(3000)
  status    String   @default("PENDING") @db.NVarChar(20)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
}

model Contact {
  id        String   @id @default(uuid()) @db.NVarChar(36)
  name      String   @db.NVarChar(150)
  email     String   @db.NVarChar(255)
  message   String   @db.NVarChar(3000)
  status    String   @default("NEW") @db.NVarChar(20)
  createdAt DateTime @default(now())
}

model Favorite {
  userId    String @db.NVarChar(36)
  productId String @db.NVarChar(36)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}
