
# ========================================
# NOIR ARCHIVE — Git Ignore
# React + Vite + Node.js + Prisma
# ========================================

# Dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
*.env
*.env.*

# Backend
backend/node_modules/
backend/.env
backend/.env.example
backend/uploads/temp/
backend/logs/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.example

# Build files
dist/
build/
**/dist/
**/build/

# Prisma generated files
**/.prisma/
**/node_modules/.prisma/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.vite/
.next/
.turbo/
coverage/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local database files
*.sqlite
*.sqlite3
*.db
*.bak
*.mdf
*.ldf
